# tester-env source build for Backrest (fork-owned; upstream ships only
# goreleaser-fed Dockerfile.alpine/Dockerfile.scratch that COPY a prebuilt binary).
#
# Three stages so source mutations stay cheap:
#   1. webui  - pnpm install (cached on package.json + lockfile) then `vite build`
#               -> webui/dist, which webui/webuinix.go embeds via //go:embed dist
#   2. build  - Go module download (cached on go.mod/go.sum) then CGO-free
#               `go build ./cmd/backrest` with the dist copied in
#   3. runtime - alpine + a SHA256-pinned restic 0.19.1 and deterministic dirs
#
# UI edits rebuild stages 1-3; server-only edits only re-run stage 2's compile
# (pnpm layer and go module cache stay cached). BuildKit cache mounts keep the
# pnpm store and Go build cache across rebuilds.

ARG NODE_VERSION=24
ARG GO_VERSION=1.26
ARG ALPINE_VERSION=3.22
ARG RESTIC_VERSION=0.19.1
ARG BACKREST_VERSION=v1.14.1

# ---------------------------------------------------------------------------
# Stage 1: webui bundle
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION}-bookworm-slim AS webui

ARG PNPM_VERSION=9.15.9
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
RUN npm install -g "pnpm@${PNPM_VERSION}"

WORKDIR /src/webui
COPY webui/package.json webui/pnpm-lock.yaml ./
RUN --mount=type=cache,id=backrest-pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

COPY webui/ ./
# `cross-env UI_OS=unix vite build` -> webui/dist (gzip assets, originals deleted;
# the Go statigz server serves the .gz files, so don't hand-serve dist).
RUN pnpm run build

# ---------------------------------------------------------------------------
# Stage 2: Go binary with the SPA embedded
# ---------------------------------------------------------------------------
FROM golang:${GO_VERSION} AS build

ARG BACKREST_VERSION

WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,id=backrest-gomod,target=/go/pkg/mod \
    go mod download

COPY . .
COPY --from=webui /src/webui/dist ./webui/dist

# -trimpath/-buildvcs=false keep the binary reproducible for a given source tree,
# so identical (baseline, patch-set) runs can share one content-addressed image.
# `-X main.version` keeps the release version non-"unknown": the server only
# enables its dev CORS middleware when version == "unknown".
RUN --mount=type=cache,id=backrest-gomod,target=/go/pkg/mod \
    --mount=type=cache,id=backrest-gobuild,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build \
        -trimpath -buildvcs=false \
        -ldflags "-s -w -X main.version=${BACKREST_VERSION}" \
        -o /out/backrest ./cmd/backrest

# ---------------------------------------------------------------------------
# Stage 3: runtime
# ---------------------------------------------------------------------------
FROM alpine:${ALPINE_VERSION}

ARG RESTIC_VERSION
RUN set -eux; \
    apk add --no-cache ca-certificates tzdata tini bzip2; \
    arch="$(apk --print-arch)"; \
    case "$arch" in \
        x86_64)  rarch=amd64; rsha=f415415624dcc452f2a02b8c33641791a8c6d6d3b65bbb3543fcf9a25151585c ;; \
        aarch64) rarch=arm64; rsha=a5f64aaab53d51e311fa3829124c5b703f2d14cf187d8640b6be3b2b49376465 ;; \
        *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    wget -q -O /tmp/restic.bz2 \
        "https://github.com/restic/restic/releases/download/v${RESTIC_VERSION}/restic_${RESTIC_VERSION}_linux_${rarch}.bz2"; \
    echo "${rsha}  /tmp/restic.bz2" | sha256sum -c -; \
    bunzip2 -c /tmp/restic.bz2 > /usr/local/bin/restic; \
    chmod 0755 /usr/local/bin/restic; \
    rm -f /tmp/restic.bz2; \
    test "$(/usr/local/bin/restic version | awk '{print $2}')" = "${RESTIC_VERSION}"

COPY --from=build /out/backrest /usr/local/bin/backrest
# Small immutable fixture tree so a plan has something to back up out of the box.
COPY .tester-env-fixtures /fixtures

# Same layout/defaults as upstream cmd/docker-entrypoint/main.go.
ENV BACKREST_PORT=0.0.0.0:9898 \
    BACKREST_DATA=/data \
    BACKREST_CONFIG=/config/config.json \
    BACKREST_RESTIC_COMMAND=/usr/local/bin/restic \
    XDG_CACHE_HOME=/cache \
    TMPDIR=/tmp

RUN mkdir -p /config /data /cache /repos /restore \
    && /usr/local/bin/backrest --version

EXPOSE 9898
VOLUME ["/config", "/data", "/cache", "/repos"]

HEALTHCHECK --interval=5s --timeout=3s --start-period=20s --retries=12 \
    CMD wget -q --spider http://127.0.0.1:9898/ || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/usr/local/bin/backrest"]
